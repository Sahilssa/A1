# Copy this to .env and fill in, or just `export` these in your shell /
# set them as GitHub Actions secrets. Never commit real values.

GEMINI_API_KEY=            # required, free: https://aistudio.google.com/apikey
PEXELS_API_KEY=            # optional, free: https://www.pexels.com/api/  (real stock photos instead of AI-generated)
AUTO_PUBLISH=false          # false = upload UNLISTED for you to review; true = fully automatic public upload

# Already have these from the trend tracker — reused as-is, nothing new to get:
YOUTUBE_API_KEY=            # from console.cloud.google.com — read-only search (tracker)
